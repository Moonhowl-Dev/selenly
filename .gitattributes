# Default: Git detects text files itself and stores them with LF line endings.
# This prevents "bad interpreter" errors in scripts (e.g. gradlew) saved on Windows.
* text=auto eol=lf

# Windows scripts must keep CRLF, otherwise cmd.exe may run them incorrectly.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: Git never changes their content.
*.jar binary

# Generated code, collapsed by default in pull request diffs on GitHub:
# the orval API client and the TanStack Router route tree.
frontend/src/api/** linguist-generated=true
frontend/src/app/routeTree.gen.ts linguist-generated=true
