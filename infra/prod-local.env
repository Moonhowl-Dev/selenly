# Variables for ./scripts/prod-local.sh: the production stack on your computer.
# Public on purpose, like the passwords in compose.dev.yml. Never use them on a server;
# the server has its own infra/.env (see .env.example).

# Browsers send every *.localhost name to your own computer, and Caddy gives
# such names certificates from its local certificate authority.
SELENLY_DOMAIN=selenly.localhost

POSTGRES_PASSWORD=selenly
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_ADMIN_PASSWORD=admin

# Images built by the script from your working copy.
WEB_IMAGE=selenly-web:local
BACKEND_IMAGE=selenly-backend:local
