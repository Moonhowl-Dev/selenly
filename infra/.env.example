# Variables for compose.prod.yml on the server.
# Copy this file to infra/.env, fill it in, and never commit .env (Git ignores it).
# Generate each password with: openssl rand -base64 32

# The domain of the application. Keycloak gets auth.<this domain>.
# Both names need a DNS record pointing at the server before the first start,
# so that Caddy can get certificates from Let's Encrypt.
SELENLY_DOMAIN=example.com

# PostgreSQL: the application's user "selenly".
POSTGRES_PASSWORD=

# PostgreSQL: Keycloak's user "keycloak", created on the first start.
KEYCLOAK_DB_PASSWORD=

# Keycloak's first admin account "admin", created on the first start.
# Change it in the admin console afterwards; this value is used only once.
KEYCLOAK_ADMIN_PASSWORD=

# The version of our two images (selenly-web, selenly-backend) to run, as published
# by the Images job of CI, e.g. 20261024-ecf1eaa-18734567890-1 (see infra/README.md). Changing it and running
# `docker compose pull && docker compose up -d` is a deployment; setting the
# previous value back is a rollback.
IMAGE_TAG=
