{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "db": {
      "command": "pnpm",
      "args": ["dlx", "@bytebase/dbhub@1.5.0", "--transport", "stdio", "--config", "infra/dbhub.toml"]
    },
    "playwright": {
      "command": "pnpm",
      "args": ["dlx", "@playwright/mcp@0.0.83", "--browser", "chromium", "--headless", "--isolated"]
    },
    "shadcn": {
      "command": "pnpm",
      "args": ["--dir", "frontend", "exec", "shadcn", "mcp"]
    }
  }
}
