# Secrets and local settings: never commit them.
# The variable template lives in .env.example (that file is committed).
.env
.env.*
!.env.example

# Claude Code: personal settings and instructions stay local
# (shared ones are committed: CLAUDE.md, .mcp.json, .claude/)
.claude/settings.local.json
CLAUDE.local.md

# Java and Gradle (backend)
.gradle/
.kotlin/
build/
out/

# Node, pnpm and Vite (frontend)
node_modules/
dist/
dist-ssr/
coverage/
*.tsbuildinfo

# Playwright: test output and saved login sessions (these contain cookies)
test-results/
playwright-report/
blob-report/
**/playwright/.cache/
**/playwright/.auth/
# Playwright MCP: screenshots and page snapshots taken by the coding agent
.playwright-mcp/

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# Editors: only the recommended VS Code extensions are committed
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
